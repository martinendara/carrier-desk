      "function": {
        "description": [
          {
            "type": "paragraph",
            "children": [
              {
                "text": "Verifies the carrier's operating authority with FMCSA. Use it as soon as the caller gives their MC number, before anything else. Never skip it and never look for loads before it passes."
              }
            ]
          }
        ],
        "message": {
          "type": "ai",
          "description": [
            {
              "type": "paragraph",
              "children": [
                {
                  "text": "Tell the caller in one short sentence that you're checking their authority. Do not mention FMCSA by name or explain the process."
                }
              ]
            }
          ],
          "example": "Got it, give me one second to pull that up."
        },
        "parameters": [
          {
            "name": "mc_number",
            "description": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "text": "The carrier's MC number, digits only, without the \"MC\" prefix"
                  }
                ]
              }
            ],
            "example": "123456",
            "required": true
          },
