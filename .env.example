# Copy to .env and fill in real values. Never commit .env.

# Legacy TMS
TMS_HOST=tramway.proxy.rlwy.net
TMS_PORT=17159
TMS_TOKEN=replace-me
TMS_READ_DEADLINE_SECONDS=5

# FMCSA (live calls only work from a US region)
FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
FMCSA_KEY=replace-me

# carrier-desk API key (the HappyRobot workflow sends it as X-API-Key)
SERVICE_API_KEY=replace-with-a-long-random-string

# Negotiation concession steps (fraction of the gap between offer and ceiling)
NEGOTIATION_STEPS=0.40,0.75,1.00
