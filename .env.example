# Copy to .env and fill in real values. Never commit .env.

# Legacy TMS
#
# TMS_MODE=live talks to TMS_HOST below. TMS_MODE=fake starts the in-process
# server from app/tms/fake_server.py, seeded from tests/fixtures, so platform
# workflow tests can fire real webhooks without spending live loads.
TMS_MODE=live
TMS_HOST=tramway.proxy.rlwy.net
TMS_PORT=17159
TMS_TOKEN=replace-me
TMS_READ_DEADLINE_SECONDS=5
TMS_FAKE_TOKEN=fake-token

# FMCSA (live calls only work from a US region)
FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
FMCSA_KEY=replace-me
FMCSA_TIMEOUT_SECONDS=5

# OTP: key for the HMAC that protects stored codes.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The service refuses to issue codes with a secret shorter than 16 bytes.
OTP_HMAC_SECRET=replace-with-a-long-random-string
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_MAX_RESENDS=1

# carrier-desk API key (the HappyRobot workflow sends it as X-API-Key)
SERVICE_API_KEY=replace-with-a-long-random-string

# Negotiation concession steps, as a fraction of the gap between the opening
# offer and MAX_BUY. Two entries: round 1 and round 2. Round 3 is not a step --
# it accepts anything at or below the ceiling, and closes otherwise.
NEGOTIATION_STEPS=0.40,0.75
# The same ladder when the pickup is inside 24 hours.
NEGOTIATION_URGENT_STEPS=0.60,0.90
NEGOTIATION_MAX_ROUNDS=3
NEGOTIATION_INCREMENT=25
NEGOTIATION_CEILING_MARGIN=25

# How long a call's state (OTP, shown loads, negotiation) is kept.
RUN_SESSION_TTL_SECONDS=3600

# Wall-clock ceiling for one HTTP request, retries included. The platform's
# webhook timeout is undocumented, so we keep this comfortably under any
# plausible value: a voice tool that hangs is a dropped call.
REQUEST_BUDGET_SECONDS=8

# Event log. Relative paths resolve from the repository root. The literal
# "memory" keeps events in the process (used by the tests).
EVENTS_JSONL_PATH=var/events.jsonl
